{
	"name": "sveltekit-edge-og-image",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@cf-wasm/og": "^0.5.0",
		"@cf-wasm/plugins": "^0.2.0",
		"@cf-wasm/resvg": "^0.4.0",
		"@cf-wasm/satori": "^0.4.2",
		"@cloudflare/vite-plugin": "^1.65.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@resvg/resvg-wasm": "^2.6.2",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@vercel/og": "^1.0.3",
		"@vitest/browser": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"og-img": "^0.2.1",
		"patch-package": "^8.0.1",
		"playwright": "^1.64.1",
		"postinstall-postinstall": "^2.1.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"satori": "^0.63.2",
		"satori-html": "^0.3.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0",
		"vite-plugin-wasm-module-workers": "^0.0.2",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"workers-og": "^0.0.27",
		"@vitest/browser-playwright": "^5.0.5",
		"wrangler": "^4.152.0"
	},
	"engines": {
		"node": ">=22.17.0"
	},
	"overrides": {
		"@cf-wasm/plugins": {
			"vite": "$vite"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
